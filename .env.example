# Server
PORT=3000
NODE_ENV=production

# File upload limits
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
TEMP_FILE_TTL_MS=300000

# Rate limiting
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=20

# CORS (comma-separated origins, leave empty for same-origin only)
CORS_ORIGINS=

# External API (optional — enables server-side analysis features)
# OPENAI_API_KEY=sk-...
# ANALYSIS_API_URL=https://api.example.com/v1/analyze
